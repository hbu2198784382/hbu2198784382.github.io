<section class="heatmap" id="heatmap">
    <div class="heatmap-header">
        <span class="heatmap-title">本月打卡</span>
        <span class="heatmap-month" id="heatmap-month"></span>
    </div>
    <div class="heatmap-weekdays" aria-hidden="true">
        <span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span>
    </div>
    <div class="heatmap-grid" id="heatmap-grid"></div>
    <div class="heatmap-footer">
        <span class="heatmap-summary" id="heatmap-summary"></span>
        <div class="heatmap-legend" aria-hidden="true">
            <span>少</span>
            <i class="heatmap-cell heatmap-level-0"></i>
            <i class="heatmap-cell heatmap-level-1"></i>
            <i class="heatmap-cell heatmap-level-2"></i>
            <i class="heatmap-cell heatmap-level-3"></i>
            <i class="heatmap-cell heatmap-level-4"></i>
            <span>多</span>
        </div>
    </div>
    <div class="heatmap-tooltip" id="heatmap-tooltip"></div>
    <script src="<%- url_for('scripts/heatmap.js') %>"></script>
</section>
